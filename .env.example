# Job Hunt OS — environment variables
# Copy to .env and fill in. NEVER commit .env.

# ---------------------------------------------------------------------------
# Claude API (analysis pipeline)
# Optional. Without it the system runs in DETERMINISTIC_ONLY mode: every
# deterministic rule still works, LLM-dependent enrichment is skipped and
# flagged. The product is usable without this key.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Apify (Slice 4 — Channel B broad discovery). Not used before Slice 4.
# Project-dedicated, rotatable token. Never passed to an Actor as input.
# ---------------------------------------------------------------------------
APIFY_TOKEN=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
JOBHUNT_DB_URL=sqlite:///./jobhunt.db
JOBHUNT_ENV=local
JOBHUNT_LOG_LEVEL=INFO
# Contact (email or URL) sent in the User-Agent to job boards. Defaults to the
# project page when unset.
JOBHUNT_HTTP_CONTACT=
